<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0" name="viewport">
<title>Scrollz - Complete Your Profile</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script>
    tailwind.config = {
      theme: {
        extend: {
          colors: {
            'scrollz-bg': '#0f0f0f',
            'scrollz-card': '#1a1a1a',
            'scrollz-border': '#333333',
            'scrollz-text-primary': '#ffffff',
            'scrollz-text-secondary': '#a0a0a0',
            'scrollz-accent': '#ffc66d',
            'scrollz-accent-light': '#ffd68f',
            'scrollz-accent-dark': '#e6a84c',
          },
          fontFamily: {
            sans: ['Inter', 'sans-serif'],
          }
        }
      }
    }
  </script>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet">
<style data-purpose="custom-utilities">
    body {
      background-color: #0f0f0f;
      color: #ffffff;
      font-family: 'Inter', sans-serif;
      -webkit-font-smoothing: antialiased;
    }
    
    .gold-gradient-text {
      background: linear-gradient(90deg, #ffd68f 0%, #e6a84c 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }

    .gold-gradient-bg {
      background: linear-gradient(90deg, #ffc66d 0%, #e6a84c 100%);
    }

    .glass-input-container {
      background-color: rgba(26, 26, 26, 0.7);
      border: 1px solid #333333;
      border-radius: 12px;
      backdrop-filter: blur(10px);
      transition: border-color 0.3s ease;
    }

    .glass-input-container:focus-within {
      border-color: #ffc66d;
    }
    
    .profile-glow {
      box-shadow: 0 0 40px rgba(255, 198, 109, 0.15);
    }
  </style>
</head>
<body class="min-h-screen flex items-center justify-center p-4">
<!-- BEGIN: MobileAppContainer -->
<main class="w-full max-w-[375px] h-[812px] bg-scrollz-bg rounded-[40px] border border-scrollz-border shadow-2xl overflow-hidden relative flex flex-col font-sans">
<!-- BEGIN: Header -->
<header class="flex items-center justify-between px-6 pt-12 pb-4">
<button aria-label="Go Back" class="text-scrollz-accent p-2 -ml-2 hover:opacity-80 transition-opacity">
<svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M15.75 19.5L8.25 12l7.5-7.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</button>
<h1 class="text-lg font-semibold text-scrollz-accent tracking-wide">Complete Your Profile</h1>
<div class="w-10"></div> <!-- Spacer for centering -->
</header>
<!-- END: Header -->
<div class="flex-1 overflow-y-auto px-6 pb-8 custom-scrollbar">
<!-- BEGIN: ProfilePhotoUpload -->
<section class="flex flex-col items-center justify-center mt-6 mb-10">
<div class="relative w-32 h-32 rounded-full border-2 border-scrollz-border bg-scrollz-card flex items-center justify-center profile-glow group cursor-pointer hover:border-scrollz-accent transition-colors">
<!-- Placeholder Avatar Icon -->
<svg class="w-16 h-16 text-gray-500 mb-2" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path clip-rule="evenodd" d="M7.5 6a4.5 4.5 0 119 0 4.5 4.5 0 01-9 0zM3.751 20.105a8.25 8.25 0 0116.498 0 .75.75 0 01-.437.695A18.683 18.683 0 0112 22.5c-2.786 0-5.433-.608-7.812-1.7a.75.75 0 01-.437-.695z" fill-rule="evenodd"></path>
</svg>
<!-- Camera Icon Overlay -->
<div class="absolute bottom-0 right-2 bg-scrollz-bg rounded-full p-1.5 border border-scrollz-border group-hover:border-scrollz-accent transition-colors">
<svg class="w-5 h-5 text-scrollz-accent" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" stroke-linecap="round" stroke-linejoin="round"></path>
<path d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
</div>
</div>
<span class="mt-4 text-sm text-scrollz-text-secondary">Add Profile Photo</span>
</section>
<!-- END: ProfilePhotoUpload -->
<!-- BEGIN: FormFields -->
<form class="space-y-4">
<!-- Full Name -->
<div class="glass-input-container flex items-center p-4">
<svg class="w-6 h-6 text-scrollz-text-secondary mr-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<div class="flex-1">
<label class="block text-xs font-medium text-scrollz-text-primary mb-1" for="fullName">Full Name</label>
<input class="w-full bg-transparent text-sm text-scrollz-text-primary placeholder-scrollz-text-secondary outline-none border-none p-0 focus:ring-0" id="fullName" placeholder="Enter your full name" type="text">
</div>
</div><div class="glass-input-container flex items-center p-4"><svg class="w-6 h-6 text-scrollz-text-secondary mr-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z" stroke-linecap="round" stroke-linejoin="round"></path></svg><div class="flex-1"><label class="block text-xs font-medium text-scrollz-text-primary mb-1" for="username">Username</label><input class="w-full bg-transparent text-sm text-scrollz-text-primary placeholder-scrollz-text-secondary outline-none border-none p-0 focus:ring-0" id="username" placeholder="Enter your username" type="text"></div></div>
<!-- Email Address -->

<!-- Mobile Number -->

<!-- Instagram Handle -->
<div class="glass-input-container flex flex-col p-4 relative pb-6">
<div class="flex items-center w-full">
<svg class="w-6 h-6 text-scrollz-text-secondary mr-3 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M6.827 6.175A2.31 2.31 0 015.186 7.23c-.38.054-.757.112-1.134.175C2.999 7.58 2.25 8.507 2.25 9.574V18a2.25 2.25 0 002.25 2.25h15A2.25 2.25 0 0021.75 18V9.574c0-1.067-.75-1.994-1.802-2.169a47.865 47.865 0 00-1.134-.175 2.31 2.31 0 01-1.64-1.055l-.822-1.316a2.192 2.192 0 00-1.736-1.039 48.774 48.774 0 00-5.232 0 2.192 2.192 0 00-1.736 1.039l-.821 1.316z" stroke-linecap="round" stroke-linejoin="round"></path>
<path d="M16.5 12.75a4.5 4.5 0 11-9 0 4.5 4.5 0 019 0zM18.75 10.5h.008v.008h-.008V10.5z" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
<div class="flex-1">
<label class="block text-xs font-medium text-scrollz-text-primary mb-1" for="instagram">Instagram Handle (Optional)</label>
<input class="w-full bg-transparent text-sm text-scrollz-text-primary placeholder-scrollz-text-secondary outline-none border-none p-0 focus:ring-0" id="instagram" placeholder="@yourusername" type="text">
</div>
</div>
<!-- Note for visible to others -->
<span class="absolute bottom-2 left-12 ml-1 text-[10px] text-scrollz-text-secondary">Visible to others on leaderboard</span>
</div>
</form>
<!-- END: FormFields -->
</div>
<!-- BEGIN: FooterAction -->
<footer class="p-6 pt-2 bg-scrollz-bg/90 backdrop-blur-md pb-10">
<button class="w-full gold-gradient-bg text-black font-semibold py-4 rounded-xl text-[15px] hover:opacity-90 transition-opacity active:scale-[0.98]">
        Complete Profile
      </button>
</footer>
<!-- END: FooterAction -->
</main>
<!-- END: MobileAppContainer -->


</body></html>