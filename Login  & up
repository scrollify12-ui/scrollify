<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" name="viewport">
<title>Scrollz - Login / Sign Up</title>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<style data-purpose="custom-colors">
    :root {
      --bg-dark: #0a0a0a;
      --text-gold: #f8c77e;
      --border-gold: #382c1e;
      --btn-google: #ffffff;
      --btn-insta-start: #ff512f;
      --btn-insta-end: #dd2476;
      --btn-mobile-bg: #1a1a1a;
      --text-gray: #a3a3a3;
    }
    body {
      background-color: var(--bg-dark);
      color: white;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }
  </style>
<style data-purpose="layout-utilities">
    .app-container {
      width: 100vw;
      height: 100vh;
      max-width: 430px; /* Max width for mobile iOS feel */
      margin: 0 auto;
      border: 1px solid var(--border-gold);
      border-radius: 40px;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      position: relative;
      background-color: var(--bg-dark);
    }
    .insta-gradient {
      background: linear-gradient(45deg, var(--btn-insta-start), var(--btn-insta-end));
    }
  </style>
</head>
<body class="flex items-center justify-center min-h-screen bg-black">
<!-- BEGIN: AppContainer -->
<main class="app-container p-6 relative">
<!-- BEGIN: Header -->
<header class="text-center mt-12 mb-8" data-purpose="logo-header">
<h1 class="text-[var(--text-gold)] text-xl font-bold tracking-widest uppercase">Scrollz</h1>
</header>
<!-- END: Header -->
<!-- BEGIN: Hero Image -->
<div class="flex justify-center mb-8 relative" data-purpose="hero-illustration">
<!-- Decorative sparks -->
<div class="absolute top-4 left-16 text-[var(--text-gold)] text-xs opacity-50">✦</div>
<div class="absolute top-0 right-16 text-[var(--text-gold)] text-sm opacity-50">✦</div>
<div class="absolute bottom-4 right-12 text-[var(--text-gold)] text-xs opacity-50">✦</div>
<!-- Placeholder for the star with sunglasses -->
<div class="w-32 h-32 flex items-center justify-center">
<img alt="Star Logo" class="object-contain drop-shadow-[0_0_15px_rgba(248,199,126,0.3)]" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBEGDsOkNSnpapYRKVoqcdGV3kZGmQlw0sZVzxfp1iKf7ORiD7zGkSkAiElMVly24bvuy0awUkQywzTWi94a1_LMrHmNE3kwHvZ0aMeagbry2eyVRAeVHT18oWRsM8BbVwOaaVzElMY0gKh2QQQSQIqpk65MZ07QUEtUhkGNTFmLfwFSRvtPoZxE0ekp1vAqTwiSdPcB9xqGlywBjAHCbEKNfBhIDrP642HSnauz_Es3vZedc0thaFv">
</div>
</div>
<!-- END: Hero Image -->
<!-- BEGIN: Welcome Text -->
<div class="text-center mb-10" data-purpose="welcome-message">
<h2 class="text-2xl font-semibold mb-2">Welcome to <span class="text-[var(--text-gold)]">SCROLLZ</span></h2>
<p class="text-[var(--text-gray)] text-sm">Scroll less. Save time. Win rewards.</p>
</div>
<!-- END: Welcome Text -->
<!-- BEGIN: Auth Buttons -->
<div class="flex flex-col gap-4 w-full px-2" data-purpose="auth-methods">
<!-- Google Login -->
<button class="w-full bg-white text-black rounded-full py-4 flex items-center justify-center font-medium transition active:scale-95">
<svg class="w-5 h-5 mr-3" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"></path>
<path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"></path>
<path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"></path>
<path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"></path>
</svg>
        Continue with Google
      </button>
<!-- Instagram Login -->
<button class="w-full insta-gradient text-white rounded-full py-4 flex items-center justify-center font-medium transition active:scale-95">
<svg class="w-5 h-5 mr-3" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
<path clip-rule="evenodd" d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm3.98-10.181a1.44 1.44 0 11-2.88 0 1.44 1.44 0 012.88 0z" fill-rule="evenodd"></path>
</svg>
        Continue with Instagram
      </button>
<!-- Mobile Login -->

</div>
<!-- END: Auth Buttons -->
<!-- BEGIN: Divider -->
<div class="flex items-center justify-center mt-8 mb-6" data-purpose="separator">
<div class="w-16 h-[1px] bg-[var(--border-gold)]"></div>
<span class="px-4 text-[var(--text-gray)] text-xs font-medium">OR</span>
<div class="w-16 h-[1px] bg-[var(--border-gold)]"></div>
</div>
<!-- END: Divider -->
<!-- BEGIN: Login Link -->
<div class="text-center" data-purpose="login-link">
<p class="text-[var(--text-gray)] text-sm mb-1">Already have an account?</p>
<a class="text-[var(--text-gold)] font-semibold hover:underline" href="#">Login</a>
</div>
<!-- END: Login Link -->
<!-- BEGIN: Footer Help -->
<div class="absolute bottom-8 left-0 right-0 text-center" data-purpose="footer-help">
<p class="text-[var(--text-gray)] text-xs mb-1">Having trouble?</p>
<a class="text-[var(--text-gold)] text-sm font-semibold hover:underline" href="#">Get Help</a>
</div>
<!-- END: Footer Help -->
</main>
<!-- END: AppContainer -->


</body></html>